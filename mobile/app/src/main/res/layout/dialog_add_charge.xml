<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/surface">

    <TextView
        android:id="@+id/tvChargeTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Anotar Compra / Fiado"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/tvChargeClientName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Cliente: Doña Carmen"
        android:textColor="@color/primary"
        android:textStyle="bold"
        android:textSize="14sp" />

    <!-- Banner informativo si tiene saldo a favor -->
    <LinearLayout
        android:id="@+id/layoutCreditNoticeBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:background="#E8F5E9"
        android:padding="10dp"
        android:gravity="center_vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvCreditNoticeText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🟢 Este cliente tiene $5.00 a favor. Se descontará automáticamente de este crédito."
            android:textColor="#2E7D32"
            android:textStyle="bold"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Selector de Moneda para Fiar: Bolívares o Dólares -->
    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/toggleChargeCurrency"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        app:singleSelection="true"
        app:selectionRequired="true"
        app:checkedButton="@id/btnChargeCurrencyUsd">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnChargeCurrencyVes"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="Bs. Bolívares"
            android:textSize="13sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnChargeCurrencyUsd"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="$ Dólares (USD)"
            android:textSize="13sp"
            android:textStyle="bold" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <!-- Campo de Monto (Bs. o USD según selección) -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilChargeAmount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:hint="Monto a Fiar en Dólares ($ USD) *">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etChargeAmountUsd"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Equivalente calculado en tiempo real y aviso de ajuste diario BCV -->
    <TextView
        android:id="@+id/tvChargeEquivBs"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="≈ Bs. 0,00 (Tasa BCV: 45.00)"
        android:textColor="@color/text_secondary"
        android:textStyle="bold"
        android:textSize="12.5sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="🔄 La deuda se indexa y ajusta diariamente a la tasa oficial del BCV"
        android:textColor="@color/ubii_cyan"
        android:textSize="11sp" />

    <!-- Concepto / Artículos -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="Artículos / Detalle (Opcional, ej. 3 Canillas, Queso)">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etChargeConcept"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnConfirmCharge"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="20dp"
        android:text="Guardar en Cuenta"
        android:textSize="15sp"
        android:textStyle="bold"
        app:cornerRadius="12dp"
        android:backgroundTint="#DE350B"
        android:textColor="@color/white" />

</LinearLayout>
