<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_badge_rounded"
    android:backgroundTint="@color/surface"
    android:padding="20dp">

    <!-- Indicador de barra superior / Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="@color/slate_200" />

    <!-- Encabezado con Icono WhatsApp y Banco Seleccionado -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:text="💬"
            android:textSize="20sp"
            android:background="@drawable/bg_badge_rounded"
            android:backgroundTint="@color/whatsapp_bg" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cobrar por WhatsApp"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/slate_900" />

            <TextView
                android:id="@+id/tvWsSelectedBankSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Datos de: Ubii App (0178)"
                android:textSize="12sp"
                android:textColor="@color/slate_500" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnWsCloseDialog"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="✕"
            android:textSize="16sp"
            android:textColor="@color/slate_500"
            android:background="?attr/selectableItemBackgroundBorderless" />
    </LinearLayout>

    <!-- Selector de Banco si el usuario tiene varios activos (PRO) -->
    <HorizontalScrollView
        android:id="@+id/scrollWsBanks"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:scrollbars="none"
        android:visibility="gone">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupWsBanks"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:selectionRequired="true" />
    </HorizontalScrollView>

    <!-- Selector de Moneda: Bs. / USD -->
    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/toggleGroupWsCurrency"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:singleSelection="true"
        app:selectionRequired="true"
        app:checkedButton="@id/btnWsCurrencyVes">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnWsCurrencyVes"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="Bs. Bolívares"
            android:textSize="13sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnWsCurrencyUsd"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="$ Dólares"
            android:textSize="13sp"
            android:textStyle="bold" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <!-- Tarjeta Display del Monto Ingresado -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/card_border_light"
        app:strokeWidth="1.5dp"
        app:cardBackgroundColor="@color/slate_50">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp"
            android:gravity="center">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvWsCurrencySymbol"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bs."
                    android:textColor="@color/ubii_cyan"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvWsDisplayAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="0"
                    android:textColor="@color/slate_900"
                    android:textSize="36sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvWsConvertedAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="≈ $0.00 USD (Tasa BCV: 45.00)"
                android:textColor="@color/slate_500"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Teclado Numérico Compacto y Limpio -->
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="3"
        android:rowCount="4"
        android:layout_marginTop="8dp"
        android:alignmentMode="alignMargins">

        <Button android:id="@+id/btnWsKey1" style="@style/Widget.Material3.Button.TonalButton" android:text="1" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/slate_900" android:backgroundTint="@color/slate_100" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_margin="2dp" android:layout_height="48dp" app:cornerRadius="10dp"/>
        <Button android:id="@+id/btnWsKey2" style="@style/Widget.Material3.Button.TonalButton" android:text="2" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/slate_900" android:backgroundTint="@color/slate_100" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_margin="2dp" android:layout_height="48dp" app:cornerRadius="10dp"/>
        <Button android:id="@+id/btnWsKey3" style="@style/Widget.Material3.Button.TonalButton" android:text="3" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/slate_900" android:backgroundTint="@color/slate_100" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_margin="2dp" android:layout_height="48dp" app:cornerRadius="10dp"/>

        <Button android:id="@+id/btnWsKey4" style="@style/Widget.Material3.Button.TonalButton" android:text="4" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/slate_900" android:backgroundTint="@color/slate_100" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_margin="2dp" android:layout_height="48dp" app:cornerRadius="10dp"/>
        <Button android:id="@+id/btnWsKey5" style="@style/Widget.Material3.Button.TonalButton" android:text="5" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/slate_900" android:backgroundTint="@color/slate_100" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_margin="2dp" android:layout_height="48dp" app:cornerRadius="10dp"/>
        <Button android:id="@+id/btnWsKey6" style="@style/Widget.Material3.Button.TonalButton" android:text="6" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/slate_900" android:backgroundTint="@color/slate_100" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_margin="2dp" android:layout_height="48dp" app:cornerRadius="10dp"/>

        <Button android:id="@+id/btnWsKey7" style="@style/Widget.Material3.Button.TonalButton" android:text="7" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/slate_900" android:backgroundTint="@color/slate_100" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_margin="2dp" android:layout_height="48dp" app:cornerRadius="10dp"/>
        <Button android:id="@+id/btnWsKey8" style="@style/Widget.Material3.Button.TonalButton" android:text="8" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/slate_900" android:backgroundTint="@color/slate_100" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_margin="2dp" android:layout_height="48dp" app:cornerRadius="10dp"/>
        <Button android:id="@+id/btnWsKey9" style="@style/Widget.Material3.Button.TonalButton" android:text="9" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/slate_900" android:backgroundTint="@color/slate_100" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_margin="2dp" android:layout_height="48dp" app:cornerRadius="10dp"/>

        <Button android:id="@+id/btnWsKeyDot" style="@style/Widget.Material3.Button.TonalButton" android:text="." android:textSize="22sp" android:textStyle="bold" android:textColor="@color/slate_900" android:backgroundTint="@color/slate_100" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_margin="2dp" android:layout_height="48dp" app:cornerRadius="10dp"/>
        <Button android:id="@+id/btnWsKey0" style="@style/Widget.Material3.Button.TonalButton" android:text="0" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/slate_900" android:backgroundTint="@color/slate_100" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_margin="2dp" android:layout_height="48dp" app:cornerRadius="10dp"/>
        <Button android:id="@+id/btnWsKeyClear" style="@style/Widget.Material3.Button.TonalButton" android:text="⌫" android:textSize="20sp" android:textStyle="bold" android:textColor="@color/expense_red" android:backgroundTint="@color/slate_100" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_margin="2dp" android:layout_height="48dp" app:cornerRadius="10dp"/>
    </GridLayout>

    <!-- Teléfono opcional del cliente -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="Teléfono del cliente (opcional, ej. 04141234567)"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etWsClientPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="phone"
            android:textSize="13sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Botón Principal Enviar por WhatsApp (Estilo Ubii App / Continuar) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnWsSubmitSend"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="12dp"
        android:text="Enviar por WhatsApp 🚀"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:backgroundTint="@color/ubii_cyan"
        app:cornerRadius="14dp" />

</LinearLayout>
