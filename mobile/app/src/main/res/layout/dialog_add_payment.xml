<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/surface">

    <!-- Indicador de arrastre superior (Bottom Sheet Handle) -->
    <View
        android:layout_width="44dp"
        android:layout_height="5dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_badge_rounded"
        android:backgroundTint="@color/border" />

    <TextView
        android:id="@+id/tvPaymentTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="💵 Registrar Abono / Pago"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:textSize="22sp" />

    <TextView
        android:id="@+id/tvPaymentClientName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Cliente: Doña Carmen"
        android:textColor="@color/primary"
        android:textStyle="bold"
        android:textSize="16sp" />

    <!-- Estado de deuda actual (Alto Contraste) -->
    <TextView
        android:id="@+id/tvPaymentCurrentDebt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Deuda actual: $18.50 USD"
        android:textColor="#991B1B"
        android:textStyle="bold"
        android:textSize="15sp" />

    <!-- Selector de Moneda para Abonar: Bolívares o Dólares (50dp Touch Target) -->
    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/togglePaymentCurrency"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        app:singleSelection="true"
        app:selectionRequired="true"
        app:checkedButton="@id/btnPaymentCurrencyUsd">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPaymentCurrencyVes"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:text="Bs. Bolívares"
            android:textAllCaps="false"
            android:textSize="14.5sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPaymentCurrencyUsd"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:text="$ Dólares (USD)"
            android:textAllCaps="false"
            android:textSize="14.5sp"
            android:textStyle="bold" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <!-- Campo de Monto Gigante a Abonar -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilPaymentAmount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="Monto a Abonar en Dólares ($ USD) *">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etPaymentAmountUsd"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal"
            android:textColor="@color/text_primary"
            android:textSize="26sp"
            android:textStyle="bold" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Equivalente calculado en tiempo real (solo visible si aplica bimoneda) -->
    <TextView
        android:id="@+id/tvPaymentEquivBs"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="≈ Bs. 0,00 (Tasa BCV: 45.00)"
        android:textColor="@color/text_primary"
        android:textStyle="bold"
        android:textSize="14.5sp"
        android:visibility="gone" />

    <!-- Nota de integración con Jornada y Excedente -->
    <TextView
        android:id="@+id/tvPaymentExcessHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="🟢 Este abono se registrará como entrada de dinero en tu Jornada de hoy para el reporte final."
        android:textColor="#065F46"
        android:textStyle="bold"
        android:textSize="12.5sp" />

    <!-- Nota / Referencia -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilPaymentNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="Nota / Referencia (Opcional, ej. Transferencia o Efectivo)">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etPaymentNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="15.5sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnConfirmPayment"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="20dp"
        android:text="Guardar Abono y Sumar a Jornada"
        android:textAllCaps="false"
        android:textSize="16.5sp"
        android:textStyle="bold"
        app:cornerRadius="14dp"
        android:backgroundTint="#00875A"
        android:textColor="@color/white" />

</LinearLayout>
