<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/surface">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="22dp"
            android:paddingTop="18dp"
            android:paddingBottom="12dp">

            <!-- Indicador de arrastre superior (Bottom Sheet Handle) -->
            <View
                android:layout_width="44dp"
                android:layout_height="5dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_badge_rounded"
                android:backgroundTint="@color/border" />

            <TextView
                android:id="@+id/tvPaymentTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💵 Registrar Abono / Pago"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/tvPaymentClientName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Cliente: Doña Carmen"
                android:textColor="@color/accent_cyan"
                android:textStyle="bold"
                android:textSize="15sp" />

            <!-- Estado de deuda actual -->
            <TextView
                android:id="@+id/tvPaymentCurrentDebt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Deuda actual: $18.50 USD"
                android:textColor="@color/expense_red"
                android:textStyle="bold"
                android:textSize="14sp" />

            <!-- Selector de Moneda para Abonar: Bolívares o Dólares -->
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/togglePaymentCurrency"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:singleSelection="true"
                app:selectionRequired="true"
                app:checkedButton="@id/btnPaymentCurrencyUsd">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPaymentCurrencyVes"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:text="Bs. Bolívares"
                    android:textAllCaps="false"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPaymentCurrencyUsd"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:text="$ Dólares (USD)"
                    android:textAllCaps="false"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <!-- Campo de Monto Gigante a Abonar -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilPaymentAmount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="Monto a Abonar en Dólares ($ USD) *">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPaymentAmountUsd"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:imeOptions="actionNext"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Equivalente calculado en tiempo real -->
            <TextView
                android:id="@+id/tvPaymentEquivBs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="≈ Bs. 0,00 (Tasa BCV: 45.00)"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:textSize="13.5sp"
                android:visibility="gone" />

            <!-- Nota de integración con Jornada y Excedente -->
            <TextView
                android:id="@+id/tvPaymentExcessHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="🟢 Este abono se registrará como entrada de dinero en tu Jornada de hoy para el reporte final."
                android:textColor="@color/income_green"
                android:textStyle="bold"
                android:textSize="12sp" />

            <!-- Nota / Referencia -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilPaymentNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="Nota / Referencia (Opcional, ej. Transferencia o Efectivo)">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPaymentNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionDone"
                    android:textColor="@color/text_primary"
                    android:textSize="14.5sp" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border" />

    <!-- Barra inferior fija de Guardado (No se esconde al salir el teclado) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="22dp"
        android:paddingVertical="12dp"
        android:background="@color/surface">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmPayment"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="💾 Guardar Abono"
            android:textAllCaps="false"
            android:textSize="15.5sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:maxLines="1"
            android:ellipsize="end"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:cornerRadius="12dp"
            android:backgroundTint="@color/accent_cyan"
            android:textColor="@color/white" />
    </LinearLayout>

</LinearLayout>
