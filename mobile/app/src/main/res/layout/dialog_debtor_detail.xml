<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/surface">

    <!-- Encabezado Cliente -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvDetailDebtorName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Doña Carmen"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/tvDetailDebtorMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Teléfono: 0414-1234567 • Cédula: V-14567890"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvDetailBalanceBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔴 Debe $18.50"
            android:textStyle="bold"
            android:textSize="13sp"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:background="@drawable/bg_badge_rounded"
            android:textColor="#C62828" />
    </LinearLayout>

    <!-- Botones de Gestión del Cliente (Protegidos con Seguridad) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDetailEdit"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="✏️ Editar Datos"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            app:strokeColor="@color/border"
            app:cornerRadius="10dp"
            android:insetTop="0dp"
            android:insetBottom="0dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDetailDelete"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="🗑️ Eliminar"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#DE350B"
            app:strokeColor="#FFCDD2"
            app:cornerRadius="10dp"
            android:insetTop="0dp"
            android:insetBottom="0dp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border"
        android:layout_marginVertical="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Historial de Movimientos"
        android:textStyle="bold"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <!-- Lista de movimientos con scroll -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_marginTop="8dp">

        <LinearLayout
            android:id="@+id/layoutLedgerEntriesContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border"
        android:layout_marginVertical="12dp" />

    <!-- Botón de Estado de Cuenta Detallado en PDF (Exclusivo PRO) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDetailSharePdf"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginBottom="8dp"
        android:text="📄 Enviar Estado de Cuenta Detallado (PDF)"
        android:textAllCaps="false"
        android:textSize="12.5sp"
        android:textStyle="bold"
        android:textColor="@color/primary"
        app:strokeColor="@color/accent_cyan"
        app:strokeWidth="1.5dp"
        app:cornerRadius="10dp" />

    <!-- Botones de Acción -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDetailClose"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="Cerrar"
            android:textSize="13sp"
            app:cornerRadius="10dp"
            android:backgroundTint="#F1F5F9"
            android:textColor="#475569" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDetailShareWhatsApp"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1.6"
            android:layout_marginStart="6dp"
            android:text="💬 Cobrar con QR"
            android:textSize="13sp"
            android:textStyle="bold"
            app:cornerRadius="10dp"
            android:backgroundTint="#00875A"
            android:textColor="@color/white" />
    </LinearLayout>

</LinearLayout>
