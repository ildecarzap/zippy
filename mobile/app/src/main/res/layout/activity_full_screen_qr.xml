<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/surface"
    android:padding="20dp"
    android:gravity="center_horizontal">

    <!-- Encabezado con Monto Gigante -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="ESCANEA O PAGA CON PAGO MÓVIL"
        android:textColor="@color/text_secondary"
        android:textStyle="bold"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvFullScreenVes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Bs. 250,00"
        android:textColor="@color/accent_green_dark"
        android:textSize="40sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvFullScreenUsd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="($5.00 USD)"
        android:textColor="@color/text_muted"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- QR Gigante (Ocupa la mayor parte de la pantalla) -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginVertical="16dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="2dp"
        app:strokeColor="@color/border"
        app:strokeWidth="2dp"
        app:cardBackgroundColor="@color/white">

        <ImageView
            android:id="@+id/ivBigQr"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="16dp"
            android:scaleType="fitCenter"
            android:contentDescription="Código QR Gigante" />

    </com.google.android.material.card.MaterialCardView>

    <!-- Datos Bancarios en Alto Contraste -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/surface_variant"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvFullScreenMerchant"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Titular: Mi Negocio"
            android:textColor="@color/accent_cyan"
            android:textStyle="bold"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/tvFullScreenBank"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Banco: Banesco (0134)"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/tvFullScreenPhone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Teléfono: 0414-1234567"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/tvFullScreenId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Cédula: V-18.456.789"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:textSize="17sp" />
    </LinearLayout>

    <!-- Botón Gigante de Salida -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDoneFullScreen"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:text="Listo / Cerrar Cobro"
        android:textSize="17sp"
        android:textStyle="bold"
        app:cornerRadius="14dp"
        android:backgroundTint="@color/primary"
        android:textColor="@color/white" />

</LinearLayout>
