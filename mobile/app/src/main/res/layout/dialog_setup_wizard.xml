<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- CONTENIDO SCROLLABLE PASO A PASO -->
    <ScrollView
        android:id="@+id/scrollWizardContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="22dp"
            android:paddingTop="20dp"
            android:paddingBottom="24dp">

        <!-- Encabezado de Progreso Paso a Paso -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvWizardStepBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_rounded"
                android:backgroundTint="@color/accent_cyan"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp"
                android:text="PASO 1 DE 5"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvWizardAutoSaveBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💾 Guardado automático"
                android:textColor="@color/income_green"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressWizard"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:layout_marginTop="12dp"
            android:max="5"
            android:progress="1"
            android:progressTint="@color/accent_cyan" />

        <TextView
            android:id="@+id/tvWizardStepTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="🌎 Elige tu País"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvWizardStepSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="4dp"
            android:text="Vamos a configurar tu aplicación paso a paso de forma sencilla."
            android:textColor="@color/text_secondary"
            android:textSize="16sp" />

        <!-- ===================================================== -->
        <!-- PASO 1: SELECCIÓN DE PAÍS                             -->
        <!-- ===================================================== -->
        <LinearLayout
            android:id="@+id/layoutWizardStep1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical"
            android:visibility="visible">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnWizardCountryVe"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:gravity="start|center_vertical"
                android:minHeight="68dp"
                android:padding="14dp"
                android:text="🇻🇪  VENEZUELA\nBolívares (Bs.) y Dólares ($ USD) • Pago Móvil"
                android:textAllCaps="false"
                android:textColor="#0A192F"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="14dp"
                app:strokeColor="@color/accent_cyan"
                app:strokeWidth="2dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnWizardCountryCo"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:gravity="start|center_vertical"
                android:minHeight="68dp"
                android:padding="14dp"
                android:text="🇨🇴  COLOMBIA\nPesos Colombianos ($ COP) • Nequi, DaviPlata, Bancolombia"
                android:textAllCaps="false"
                android:textColor="#0A192F"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="14dp"
                app:strokeColor="@color/border"
                app:strokeWidth="2dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnWizardCountryAr"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:gravity="start|center_vertical"
                android:minHeight="68dp"
                android:padding="14dp"
                android:text="🇦🇷  ARGENTINA\nPesos Argentinos ($ ARS) • Mercado Pago, Cuenta DNI, BNA+"
                android:textAllCaps="false"
                android:textColor="#0A192F"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="14dp"
                app:strokeColor="@color/border"
                app:strokeWidth="2dp" />

            <TextView
                android:id="@+id/tvWizardCountryLockNotice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_badge_rounded"
                android:backgroundTint="@color/surface_variant"
                android:padding="12dp"
                android:text="🔒 Importante: El país queda fijo después de esta configuración inicial. Si luego necesitas cambiarlo, nuestro equipo de Atención al Cliente te asistirá."
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- ===================================================== -->
        <!-- PASO 2: DATOS DEL COMERCIO Y COBRO (POR PAÍS)         -->
        <!-- ===================================================== -->
        <LinearLayout
            android:id="@+id/layoutWizardStep2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1. ¿Cómo se llama tu negocio, bodega o taxi?"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilWizardMerchantName"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:hint="Ej: Bodega Don Pedro / Taxi Juan">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etWizardMerchantName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapWords"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/tvWizardPhoneLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="2. Número de teléfono donde recibes tus pagos:"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilWizardPhone"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:hint="Teléfono">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etWizardPhone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="phone"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/tvWizardIdLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="3. Tu documento de identidad o fiscal:"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilWizardIdCard"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:hint="Documento">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etWizardIdCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapCharacters"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Tasa BCV (Solo visible para Venezuela) -->
            <LinearLayout
                android:id="@+id/layoutWizardBcvSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="4. Tasa del Dólar BCV de hoy (se actualiza sola):"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="Tasa BCV (Bs./$)">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etWizardBcvRate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="numberDecimal"
                            android:textColor="@color/text_primary"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnWizardFetchBcv"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="56dp"
                        android:layout_marginStart="10dp"
                        android:text="🔄 BCV Hoy"
                        android:textAllCaps="false"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:cornerRadius="12dp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- ===================================================== -->
        <!-- PASO 3: SELECCIÓN DE BANCO / BILLETERA Y QR           -->
        <!-- ===================================================== -->
        <LinearLayout
            android:id="@+id/layoutWizardStep3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_rounded"
                android:backgroundTint="@color/surface_variant"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="BANCO O BILLETERA SELECCIONADA:"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvWizardSelectedBank"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="🏦 Selecciona tu banco abajo"
                    android:textColor="@color/accent_cyan"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="8dp"
                android:text="👇 Toca con tu dedo el banco donde recibes tus pagos:"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/layoutWizardBanksContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- Subir QR Opcional en este mismo paso -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_badge_rounded"
                android:backgroundTint="@color/surface_variant"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:id="@+id/tvWizardQrStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📸 Código QR del banco (Opcional: puedes subirlo ahora o después)"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnWizardUploadQr"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:text="📸 Subir Imagen de mi QR"
                    android:textAllCaps="false"
                    android:textColor="#0A192F"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:strokeColor="@color/border"
                    app:backgroundTint="@color/white"
                    app:cornerRadius="12dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ===================================================== -->
        <!-- PASO 4: PERMISO DE ESCUCHA DE PAGOS                   -->
        <!-- ===================================================== -->
        <LinearLayout
            android:id="@+id/layoutWizardStep4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvWizardNotifStatusBadge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_rounded"
                android:backgroundTint="@color/surface_variant"
                android:padding="16dp"
                android:text="⚠️ Estado actual: Falta activar la lectura de notificaciones"
                android:textColor="@color/warning_orange"
                android:textSize="17sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_badge_rounded"
                android:backgroundTint="@color/surface_variant"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="¿Cómo activarlo en 3 pasos fáciles?"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingExtra="6dp"
                    android:text="1️⃣ Toca el botón grande de abajo.\n2️⃣ En la lista que se abre, busca donde dice &quot;Zeasy&quot; y préndelo.\n3️⃣ Toca en &quot;Permitir&quot; y regresa a esta pantalla."
                    android:textColor="@color/text_primary"
                    android:textSize="16sp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnWizardActivateNotif"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="16dp"
                android:backgroundTint="@color/accent_cyan"
                android:text="👉 Tocar Aquí para Activar Permiso"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="17sp"
                android:textStyle="bold"
                app:cornerRadius="14dp" />
        </LinearLayout>

        <!-- ===================================================== -->
        <!-- PASO 5: SEGUNDO PLANO Y PRUEBA DE SONIDO              -->
        <!-- ===================================================== -->
        <LinearLayout
            android:id="@+id/layoutWizardStep5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvWizardBatteryStatusBadge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_rounded"
                android:backgroundTint="@color/surface_variant"
                android:padding="16dp"
                android:text="🔋 Segundo plano: Permite que Zeasy funcione con la pantalla apagada"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnWizardActivateBattery"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="12dp"
                android:text="🔋 Permitir Uso con Pantalla Apagada"
                android:textAllCaps="false"
                android:textColor="#0A192F"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="14dp"
                app:backgroundTint="@color/white"
                app:strokeColor="@color/accent_cyan"
                app:strokeWidth="2dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_badge_rounded"
                android:backgroundTint="@color/surface_variant"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🔊 ¡Escucha cómo te avisará Zeasy!"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Toca este botón para escuchar una prueba de pago recibido:"
                    android:textColor="@color/text_secondary"
                    android:textSize="15sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnWizardTestSound"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="10dp"
                    android:text="🔊 Escuchar Prueba de Pago Ahora"
                    android:textAllCaps="false"
                    android:textColor="#0A192F"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:strokeColor="@color/border"
                    app:backgroundTint="@color/white"
                    app:cornerRadius="14dp" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
    </ScrollView>

    <!-- ===================================================== -->
    <!-- BARRA INFERIOR FIJA CON LOS BOTONES DE NAVEGACIÓN      -->
    <!-- Protegida contra solapamiento con botones del sistema  -->
    <!-- ===================================================== -->
    <LinearLayout
        android:id="@+id/layoutWizardBottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:elevation="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnWizardBack"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:layout_marginEnd="10dp"
            android:minWidth="105dp"
            android:text="⬅ Atrás"
            android:textAllCaps="false"
            android:textColor="#0A192F"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:strokeColor="@color/border"
            app:backgroundTint="@color/white"
            app:cornerRadius="14dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnWizardNext"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:backgroundTint="@color/income_green"
            android:text="Siguiente Paso ➔"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="14dp" />
    </LinearLayout>

</LinearLayout>
