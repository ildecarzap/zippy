<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="4dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/card_border_light"
    app:strokeWidth="1dp"
    app:cardBackgroundColor="@color/surface"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="14dp"
        android:gravity="center_vertical">

        <!-- Insignia del Banco con Color de Marca -->
        <TextView
            android:id="@+id/tvBankItemBadge"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="UB"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="14sp"
            android:background="@drawable/bg_badge_rounded"
            android:backgroundTint="@color/ubii_cyan" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvBankItemName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ubii App"
                android:textColor="@color/slate_900"
                android:textStyle="bold"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvBankItemCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Código: 0178"
                android:textColor="@color/slate_500"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvBankItemStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⭐ Activo"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/ubii_cyan"
            android:background="@drawable/bg_badge_rounded"
            android:backgroundTint="@color/ubii_cyan_bg"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:visibility="gone" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
