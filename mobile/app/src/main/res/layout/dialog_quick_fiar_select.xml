<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="22dp"
    android:background="@color/surface">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Fiar a Cuenta de Cliente"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/tvQuickFiarAmountSummary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Monto: $10.00 USD (Bs. 455,00)"
        android:textColor="#DE350B"
        android:textStyle="bold"
        android:textSize="15sp" />

    <!-- Selector / Nombre de Cliente -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="Nombre del Cliente * (escribe o selecciona)">

        <AutoCompleteTextView
            android:id="@+id/actvQuickFiarClientName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPersonName|textCapWords"
            android:padding="14dp"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Detalle / Concepto -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="Artículos / Nota (Opcional, ej. Canilla, queso)">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etQuickFiarConcept"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnConfirmQuickFiar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="20dp"
        android:text="Confirmar Fiado"
        android:textSize="15sp"
        android:textStyle="bold"
        app:cornerRadius="12dp"
        android:backgroundTint="#DE350B"
        android:textColor="@color/white" />

</LinearLayout>
