<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/surface">

    <TextView
        android:id="@+id/tvEditTxTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Detalle del Movimiento"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/tvEditTxSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Modifica los datos del registro o concílialo con un fiado"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <!-- Sección de Conciliación con Libreta de Fiados (Solo para Ingresos) -->
    <LinearLayout
        android:id="@+id/layoutTxFiadoSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="@drawable/bg_badge_rounded"
        android:backgroundTint="@color/accent_green_bg"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvTxFiadoStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📒 ¿Este pago corresponde a un Fiado de la Libreta?"
            android:textColor="@color/accent_green"
            android:textStyle="bold"
            android:textSize="12.5sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAssignTxToFiado"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:text="📒 Considerar Pago de un Fiado (Descontar Deuda)"
            android:textSize="12sp"
            android:textStyle="bold"
            android:backgroundTint="#00875A"
            android:textColor="@color/white"
            app:cornerRadius="10dp" />
    </LinearLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:hint="Monto en Bolívares (Bs.)">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etEditTxAmount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:hint="Tipo / Concepto">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etEditTxCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@color/text_primary" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:hint="Referencia bancaria (Opcional)">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etEditTxReference"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@color/text_primary" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:hint="Nota / Detalle">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etEditTxNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@color/text_primary" />
    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="20dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDeleteTx"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="🗑️ Eliminar"
            android:textSize="14sp"
            android:textStyle="bold"
            app:strokeColor="@color/expense_red"
            android:textColor="@color/expense_red" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveEditTx"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="Guardar"
            android:textSize="14sp"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            android:backgroundTint="@color/accent_cyan"
            android:textColor="@color/white" />
    </LinearLayout>

</LinearLayout>
