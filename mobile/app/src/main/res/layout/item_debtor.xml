<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/border"
    app:strokeWidth="1dp"
    app:cardBackgroundColor="@color/surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Fila 1: Nombre y Badge de Estado -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvDebtorName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Doña Carmen"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tvDebtorMeta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0414-1234567 • V-14567890"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvDebtorStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔴 Debe $18.50"
                android:textStyle="bold"
                android:textSize="12sp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:background="@drawable/bg_badge_rounded"
                android:textColor="#C62828" />
        </LinearLayout>

        <!-- Fila 2: Monto equivalente en Bolívares (Tasa BCV) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvDebtorBalanceVes"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Equivalente: Bs. 841,75 (BCV)"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvDebtorUpdatedTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Último movimiento: Hoy"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/border"
            android:layout_marginVertical="10dp" />

        <!-- Fila 3: Botones de Acción Rápida -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnItemAddCharge"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="+ Fiar"
                android:textSize="12sp"
                android:textStyle="bold"
                app:cornerRadius="8dp"
                android:backgroundTint="#FFEBEE"
                android:textColor="#C62828"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="#FFCDD2" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnItemAddPayment"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                android:text="💵 Abonar"
                android:textSize="12sp"
                android:textStyle="bold"
                app:cornerRadius="8dp"
                android:backgroundTint="#E8F5E9"
                android:textColor="#2E7D32"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="#C8E6C9" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnItemWhatsApp"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginStart="4dp"
                android:text="💬 Cobrar"
                android:textSize="12sp"
                android:textStyle="bold"
                app:cornerRadius="8dp"
                android:backgroundTint="#00875A"
                android:textColor="@color/white"
                android:insetTop="0dp"
                android:insetBottom="0dp" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
