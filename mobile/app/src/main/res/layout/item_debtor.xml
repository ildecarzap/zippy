<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="1dp"
    app:strokeColor="@color/border"
    app:strokeWidth="1.5dp"
    app:cardBackgroundColor="@color/surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Fila 1: Nombre Gigante y Badge de Saldo de Alto Contraste -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvDebtorName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Doña Carmen"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:textSize="19sp" />

                <TextView
                    android:id="@+id/tvDebtorMeta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0414-1234567 • V-14567890"
                    android:textColor="@color/text_secondary"
                    android:textStyle="bold"
                    android:textSize="13.5sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvDebtorStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔴 Debe $18.50"
                android:textStyle="bold"
                android:textSize="15sp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:background="@drawable/bg_badge_rounded"
                android:textColor="#991B1B" />
        </LinearLayout>

        <!-- Fila 2: Monto equivalente en Moneda Local (Alto Contraste) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvDebtorBalanceVes"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Equivalente: Bs. 841,75 (BCV)"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvDebtorUpdatedTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Último: Hoy"
                android:textColor="@color/text_secondary"
                android:textSize="12.5sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/border"
            android:layout_marginVertical="12dp" />

        <!-- Fila 3: Botones de Acción Rápida de Alta Accesibilidad (Alineados en 1 sola línea) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnItemAddCharge"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="➕ Fiar"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:maxLines="1"
                android:ellipsize="end"
                android:paddingHorizontal="6dp"
                app:cornerRadius="10dp"
                android:backgroundTint="@color/surface_variant"
                android:textColor="@color/text_primary"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/border" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnItemAddPayment"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                android:text="💵 Abonar"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:maxLines="1"
                android:ellipsize="end"
                android:paddingHorizontal="6dp"
                app:cornerRadius="10dp"
                android:backgroundTint="@color/accent_blue_bg"
                android:textColor="@color/accent_blue"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/accent_blue" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnItemWhatsApp"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="💬 Cobrar"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:maxLines="1"
                android:ellipsize="end"
                android:paddingHorizontal="6dp"
                app:cornerRadius="10dp"
                android:backgroundTint="@color/accent_cyan"
                android:textColor="@color/white"
                android:insetTop="0dp"
                android:insetBottom="0dp" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
