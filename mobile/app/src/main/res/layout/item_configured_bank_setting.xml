<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardConfiguredBankItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/border"
    app:strokeWidth="1dp"
    app:cardBackgroundColor="@color/surface_variant">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Fila Superior: Badge, Nombre, Estrella Principal y Botón Eliminar Banco -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvBankItemBadge"
                android:layout_width="44dp"
                android:layout_height="28dp"
                android:gravity="center"
                android:text="BDV"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="11sp"
                android:background="@drawable/bg_badge_rounded"
                android:backgroundTint="#005CB9" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvBankItemName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Banco de Venezuela"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvBankItemCode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Código: 0102"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvBankItemPrimaryBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="⭐ PRINCIPAL"
                    android:textColor="@color/accent_cyan"
                    android:textStyle="bold"
                    android:textSize="10sp"
                    android:background="#1500D2C4"
                    android:paddingHorizontal="7dp"
                    android:paddingVertical="2dp"
                    android:visibility="gone" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBankItemDeleteBank"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:text="🗑️ Quitar Banco"
                android:textColor="@color/expense_red"
                android:textSize="12sp"
                android:textStyle="bold"
                android:paddingHorizontal="8dp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="10dp"
            android:background="@color/border" />

        <!-- Estado del QR -->
        <TextView
            android:id="@+id/tvBankItemQrStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚠️ Sin código QR cargado"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Acciones del QR (Subir/Cambiar, Ver, Quitar) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBankItemUploadQr"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="✂️ Cargar QR"
                android:textSize="12sp"
                android:textStyle="bold"
                app:cornerRadius="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBankItemViewQr"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginHorizontal="2dp"
                android:text="👁️ Ver"
                android:textSize="12sp"
                android:textStyle="bold"
                app:cornerRadius="8dp"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBankItemDeleteQr"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="2dp"
                android:text="🗑️ Quitar QR"
                android:textColor="@color/expense_red"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Botón para Establecer como Principal -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBankItemMakePrimary"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginTop="4dp"
            android:text="⭐ Marcar como Banco Principal Predeterminado"
            android:textSize="11sp"
            android:textColor="@color/accent_cyan"
            android:visibility="gone" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
