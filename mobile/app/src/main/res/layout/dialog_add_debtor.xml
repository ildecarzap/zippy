<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/surface">

    <!-- Indicador de arrastre superior (Bottom Sheet Handle) -->
    <View
        android:layout_width="44dp"
        android:layout_height="5dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_badge_rounded"
        android:backgroundTint="@color/border" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📒 Anotar Nuevo Cliente"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:textSize="22sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Añade a tu libreta para registrar compras a crédito o saldos a favor"
        android:textColor="@color/text_secondary"
        android:textStyle="bold"
        android:textSize="14sp" />

    <!-- Botón grande para cargar datos desde la libreta de contactos del teléfono -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPickContactNewDebtor"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="16dp"
        android:text="📇 Cargar desde Contactos del Teléfono"
        android:textAllCaps="false"
        android:textSize="14.5sp"
        android:textStyle="bold"
        app:cornerRadius="12dp" />

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:hint="Nombre o Apodo del Cliente * (ej. Doña Carmen)">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etNewDebtorName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPersonName|textCapWords"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilNewDebtorPhone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="Teléfono WhatsApp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etNewDebtorPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="phone"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilNewDebtorId"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="Documento / Identificación (Opcional)">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etNewDebtorId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapCharacters"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSaveNewDebtor"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="20dp"
        android:text="Guardar en Libreta"
        android:textAllCaps="false"
        android:textSize="16.5sp"
        android:textStyle="bold"
        app:cornerRadius="14dp"
        android:backgroundTint="@color/primary"
        android:textColor="@color/white" />

</LinearLayout>
