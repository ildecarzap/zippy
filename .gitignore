# ==========================================
# Zippy App Monorepo (.gitignore)
# ==========================================

# OS & Editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~

# Android (Mobile)
mobile/.gradle/
mobile/*/.gradle/
mobile/build/
mobile/*/build/
mobile/local.properties
mobile/*/local.properties
mobile/*.iml
mobile/.cxx/
mobile/captures/
mobile/app/build/
*.apk
*.aab

# Python / FastAPI (Web)
web/__pycache__/
web/*/__pycache__/
web/*/*/__pycache__/
web/*.py[cod]
web/.pytest_cache/
web/*.db
web/*.sqlite3
web/.venv/
web/venv/
web/env/

# Sensitive env files (template provided in .env.example)
web/.env
