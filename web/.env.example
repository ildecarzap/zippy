# ==============================================================================
# CONFIGURACIÓN ZIPPY WEB & CONTROL HUB (CIEM TECH SOLUTIONS C.A)
# ==============================================================================

ENVIRONMENT=development
DEBUG=true

# ------------------------------------------------------------------------------
# 1. BASE DE DATOS
# ------------------------------------------------------------------------------
# OPCIÓN A (Local PostgreSQL - Docker activo):
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/cobrixpay

# OPCIÓN B (Supabase en la Nube):
# Copia la URI de Supabase desde: Project Settings -> Database -> Connection string (URI)
# DATABASE_URL=postgresql://postgres:[TU-PASSWORD]@db.[TU-PROYECTO].supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# 2. SEGURIDAD DEL PANEL ADMINISTRATIVO PRIVADO
# ------------------------------------------------------------------------------
# URL privada secreta (Cámbiala para que solo tú sepas cómo ingresar al panel)
# Ejemplo: si colocas 'ciem-privado-8921', tu login será http://tudominio/ciem-privado-8921/login
ADMIN_SECRET_PATH=portal-seguro-ciem
ADMIN_SESSION_SECRET=ciem-super-secret-key-zippy-2026-auth-protection-9921

# Credenciales maestras iniciales
INITIAL_ADMIN_USER=admin_ciem
INITIAL_ADMIN_PASSWORD=Zippy2026#CiemAdmin

# ------------------------------------------------------------------------------
# 3. AUTH0 (OPCIONAL - Para inicio de sesión con Auth0 Universal Login)
# ------------------------------------------------------------------------------
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_CALLBACK_URL=http://localhost:8088/portal-seguro-ciem/auth0/callback

# ------------------------------------------------------------------------------
# 4. INTEGRACIÓN COBRIXPAY (PAGOS Y WEBHOOKS)
# ------------------------------------------------------------------------------
COBRIXPAY_BASE_URL=https://app.cobrix-pay.com
COBRIXPAY_API_URL=https://api.cobrix-pay.com
COBRIXPAY_WEBHOOK_SECRET=zippy_ciem_webhook_secret_key_2026

# ID de la empresa en CobrixPay:
# - En desarrollo local: 5 ("Ciem tech Solutions C.A")
# - En producción: Ajustar al ID asignado a CIEM en el CobrixPay real
COBRIXPAY_COMPANY_ID=5
COBRIXPAY_PLAN_PRICE_USD=2.99

# Credenciales de API de CobrixPay (para generar deudas auténticas en api.cobrix-pay.com):
COBRIXPAY_API_USER=
COBRIXPAY_API_PASSWORD=
COBRIXPAY_API_KEY=
COBRIXPAY_API_TOKEN=

# Base de datos de CobrixPay (OPCIONAL):
# Si en producción Zippy y CobrixPay están en PostgreSQLs separados, colocar aquí la conexión a CobrixPay:
# COBRIXPAY_DATABASE_URL=postgresql://user:password@host:5432/cobrixpay_prod
COBRIXPAY_DATABASE_URL=


# ------------------------------------------------------------------------------
# 5. DATOS CORPORATIVOS CIEM
# ------------------------------------------------------------------------------
COMPANY_NAME=Ciem tech solutions C.A
COMPANY_RIF=J-50849495-4
COMPANY_EMAIL=ildemaro.carrasco@outlook.com
COMPANY_PHONE=+58 4242603112
COMPANY_WHATSAPP=584242603112
